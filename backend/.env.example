# Copia este archivo a .env y completa los valores. NUNCA commitear .env (ya está en .gitignore).

# --- Entra ID App (ya existente, usada para el SharePoint indexer) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- SharePoint origen ---
SHAREPOINT_SITE_URL=https://<tenant>.sharepoint.com/sites/<site>
SHAREPOINT_TENANT_HOST=<tenant>.sharepoint.com
SHAREPOINT_FOLDER_PATH=sites/<site>/<library>/<folder>

# --- Azure AI Search ---
SEARCH_SERVICE_NAME=
SEARCH_ENDPOINT=https://<search-service>.search.windows.net
SEARCH_API_VERSION=2026-08-01-preview
SEARCH_DATASOURCE_NAME=sharepoint-demo-datasource
SEARCH_INDEX_NAME=idx-sharepoint-demo
SEARCH_SKILLSET_NAME=sharepoint-demo-skillset
SEARCH_INDEXER_NAME=sharepoint-demo-indexer
SEARCH_ADMIN_KEY=

# --- Azure OpenAI / Foundry models ---
AZURE_OPENAI_ENDPOINT=https://<foundry-resource>.cognitiveservices.azure.com
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# --- Foundry ---
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL_DEPLOYMENT=gpt-4.1-mini
FOUNDRY_AGENT_NAME=agent-sharepoint
FOUNDRY_SEARCH_CONNECTION_NAME=<search-service-name>

# --- API local (FastAPI) ---
GRAPH_WEBHOOK_CLIENT_STATE=
PUBLIC_WEBHOOK_BASE_URL=
